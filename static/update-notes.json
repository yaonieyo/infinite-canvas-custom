  "items": [
    {
      "type": "feature",
      "text": "\u65b0\u589e\u5267\u672c\u5230\u6545\u4e8b\u677f\u5de5\u4f5c\u6d41\uff1a\u652f\u6301\u7eaf\u5267\u672c\u62c6\u955c\u3001\u8be6\u7ec6\u5206\u955c\u8f93\u5165\u548c\u6545\u4e8b\u677f\u8282\u70b9\u3002"
    },
    {
      "type": "feature",
      "text": "\u65b0\u589e\u5bfc\u6f14\u5206\u955c\u6545\u4e8b\u677f\uff1a\u652f\u6301\u4e5d\u5bab\u683c\u3001\u5341\u4e8c\u5bab\u683c\u3001\u5f69\u8272\u5206\u955c\u548c\u5199\u5b9e\u5206\u955c\u56fe\u8f93\u51fa\u3002"
    },
    {
      "type": "feature",
      "text": "\u6545\u4e8b\u677f\u8f93\u51fa\u6539\u4e3a\u771f\u5b9e\u5206\u955c\u5e27\uff0c\u5206\u955c\u56fe\u4e0e\u89c6\u9891\u8282\u70b9\u5206\u5f00\u5904\u7406\uff0c\u4fdd\u7559\u72ec\u7acb\u91cd\u65b0\u751f\u6210\uff0c\u540c\u65f6\u4fee\u590d\u8f93\u51fa\u8282\u70b9\u4e0d\u5c45\u4e2d\u3001\u9ed1\u8fb9\u548c\u7ed3\u679c\u4e0d\u53ef\u89c1\u95ee\u9898\u3002"
    },
    {
      "type": "feature",
      "text": "\u5efa\u7acb\u6545\u4e8b\u677f\u8d44\u4ea7\u6536\u96c6\u5668\uff1a\u6309\u4eba\u7269\u3001\u573a\u666f\u3001\u9053\u5177\u5206\u7c7b\uff0c\u652f\u6301\u65e0\u8d44\u4ea7\u3001\u624b\u52a8\u9009\u62e9\u548c\u591a\u955c\u5934\u6536\u96c6\u3002"
    },
    {
      "type": "feature",
      "text": "\u65b0\u589e\u8d44\u4ea7\u5339\u914d\u4fe1\u5fc3\u5ea6\u4e0e\u5347\u964d\u6392\u5e8f\uff0c\u7528\u4e8e\u5904\u7406\u4eba\u7269\u522b\u540d\u3001\u5907\u6ce8\u540d\u548c\u591a\u4e2a\u5019\u9009\u8d44\u4ea7\u3002"
    },
    {
      "type": "fix",
      "text": "\u4fee\u590d\u8d44\u4ea7\u5019\u9009\u5206\u7c7b\u9519\u8bef\uff1a\u5916\u5356\u888b\u3001\u9e21\u86cb\u3001\u6ce1\u9762\u3001\u8fce\u5bbe\u724c\u7b49\u9053\u5177\u4e0d\u518d\u88ab\u8bef\u5224\u4e3a\u4eba\u7269\u6216\u573a\u666f\u3002"
    },
    {
      "type": "fix",
      "text": "\u4fee\u590d\u751f\u56fe\u63d0\u793a\u8bcd\u53c2\u8003\u56fe\u91cd\u590d\uff1a\u540c\u4e00\u573a\u666f\u81ea\u52a8\u5408\u5e76\uff0c\u4e0d\u540c\u573a\u666f\u4fdd\u7559\uff0c\u4eba\u7269\u548c\u9053\u5177\u53c2\u8003\u4e0d\u53d7\u5f71\u54cd\u3002"
    },
    {
      "type": "feature",
      "text": "\u5408\u5e76\u4e0a\u6e38\u753b\u5e03\u3001\u6a21\u578b\u548c\u7d20\u6750\u7ba1\u7406\u66f4\u65b0\uff0c\u4fdd\u7559\u5f53\u524d\u5267\u672c\u4e0e\u6545\u4e8b\u677f\u5b9a\u5236\u529f\u80fd\uff0c\u5e76\u8865\u5145\u9879\u76ee\u4ecb\u7ecd\u3001\u5907\u4efd\u8bf4\u660e\u548c\u7248\u672c\u57fa\u7ebf\u8bb0\u5f55\u3002"
    }
  ]
}
